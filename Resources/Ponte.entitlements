<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The microphone. Declared for the hardened runtime, which notarization requires; the app is
	     not sandboxed, so this is belt and braces on top of the Info.plist usage string. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
